<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Benvingut</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header>
        <h1>Detall Productes per <%= user.name %>!</h1>
        <h2><%- htmlMessage %></h2>
    </header>
    <main>
        <section>
            <h2>Llista de Productes</h2>
            <ul class="product-list">
                    <li class="product-item">
                        <strong> <%= products.id %> </strong>
                        <span>Producto: <%= products.name %></span>
                        <span>Precio: <%= products.precio %></span>
                        <span>Categoria: <%= products.categoria %></span>
                    </li>
            </ul>
        </section>
    </main>
</body>

</html>