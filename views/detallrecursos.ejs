<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Benvingut</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header>
        <h1>Detall Recursos per <%= user.name %>!</h1>
        <h2><%- htmlMessage %></h2>
    </header>
    <main>
        <section>
            <h2>Llista de Recursos</h2>
            <ul class="product-list">
                    <li class="product-item">
                        <strong> <%= recursos.recursos_id %> </strong>
                        <span>Tipus: <%= recursos.tipus %></span>
                        <span>Estat: <%= recursos.estat %></span>                    
                    </li>
            </ul>
        </section>
    </main>
</body>

</html>