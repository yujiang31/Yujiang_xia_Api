<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Benvingut</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <header>
        <h1>Gestió de Productes per <%= user.name %>!</h1>
        <h2><%- htmlMessage %></h2>
    </header>
    <main>
        <section>
            <h2>Llista de Productes</h2>
            <ul class="product-list">
                <% products.forEach(products=> { %>
                    <li class="product-item">
                        <strong> <%= products.id %> </strong>
                        <span>Nombre: <%= products.nombre %></span>
                        <span>Categoria: <%= products.categoria %></span>
                        <span><a href="/products/<%= products.id%>">Detall de Producte</a></span>
                        <span><a href="/products/<%= products.id %>/editar">Editar Producto</a></span>    
                    </li>
                    <% }); %>
            </ul>
        </section>
    </main>
</body>

</html>