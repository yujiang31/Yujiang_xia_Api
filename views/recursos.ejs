<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Benvingut</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <header>
        <h1>Gestió de Recursos per <%= user.name %>!</h1>
        <h2><%- htmlMessage %></h2>
    </header>
    <main>
        <section>
            <h2>Llista de Recursos</h2>
            <ul class="product-list">
                <% data.products.forEach(product=> { %>
                    <li class="product-item">
                        <strong> <%= product.id %> </strong>
                        <span>Categoria: <%= product.categoria %></span>
                        <span><a href="/recursos/<%= product.id %>">Detall de Producte</a></span>
                        <span><a href="/recursos/<%= product.id %>/editar">Editar Producte</a></span>
                    </li>
                    <% }); %>
            </ul>
        </section>
    </main>
</body>

</html>